{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "benchy-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  // The only public entry is the Pages proxy on the site origin; the service
  // binding does not need a route, so the workers.dev URL stays off.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "benchy-db",
      "database_id": "20b0613c-7ce4-4131-9c38-e69c524773e1",
      "migrations_dir": "../../packages/db/migrations"
    },
    {
      // The paper library (CONICET Digital), read-only from the Worker.
      // Built and refreshed with apps/api/library/build.py.
      "binding": "LIBRARY",
      "database_name": "benchy-library",
      "database_id": "b8e87ad8-f756-4afb-bfc3-424ba1e37303"
    }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "BETTER_AUTH_URL": "https://getbenchy.lat",
    "EMAIL_FROM": "auth@getbenchy.lat",
    "OWNER_NOTIFY_EMAIL": "francis@surus.lat"
  }
  // BETTER_AUTH_SECRET is a secret, not a var: it does not belong here.
  // Locally it comes from apps/api/.dev.vars (gitignored, not committed).
  // In production, set it once via: npx wrangler secret put BETTER_AUTH_SECRET
}
