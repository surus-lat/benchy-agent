# peel-org.env — identifiers for scripts/peel-org.sh.
#
# Copy to scripts/peel-org.env (gitignored — DO NOT COMMIT: this repo is
# public), fill every value, and keep the filled copy in the ops vault.
# Every value is discoverable read-only; the discovery command is above
# each entry. Run them with the operator's AWS credentials in us-east-1.

# --- account / cluster --------------------------------------------------
# aws sts get-caller-identity --query Account --output text
# (used to derive ECR image and role ARNs; no variable — auto-detected)

#CLUSTER=benchy
#AWS_REGION=us-east-1

# --- multiplex -----------------------------------------------------------
# aws efs describe-file-systems --query 'FileSystems[].{id:FileSystemId,name:Name}'
# (the file system the multiplex service mounts for profiles/)
MULTIPLEX_FS_ID=fs-XXXXXXXXXXXXXXXXX

# aws elbv2 describe-target-groups --query 'TargetGroups[?contains(TargetGroupName,`multiplex`)].TargetGroupArn'
MULTIPLEX_TG_ARN=arn:aws:elasticloadbalancing:us-east-1:000000000000:targetgroup/benchy-agent-multiplex/XXXXXXXXXXXXXXXX

# aws elbv2 describe-listeners --load-balancer-arn <alb-arn> \
#   --query 'Listeners[?Port==`443`].ListenerArn' --output text
LISTENER_ARN=arn:aws:elasticloadbalancing:us-east-1:000000000000:listener/app/benchy-agents/XXXXXXXXXXXXXXXX/XXXXXXXXXXXXXXXX

# --- per-org dedicated EFS ----------------------------------------------
# One entry per org that can be peeled. Migrated orgs keep the EFS their
# dedicated service used (deferred deletion, runbook §5); orgs born in
# the multiplex omit this and pass --create-efs.
# aws efs describe-file-systems --query 'FileSystems[].{id:FileSystemId,name:Name}'
ORG_SURUS_FS_ID=fs-XXXXXXXXXXXXXXXXX
ORG_CONICET_FS_ID=fs-XXXXXXXXXXXXXXXXX
ORG_UNTREF_FS_ID=fs-XXXXXXXXXXXXXXXXX

# --- networking ----------------------------------------------------------
# aws ecs describe-services --cluster benchy --services agent-surus \
#   --query 'services[0].networkConfiguration.awsvpcConfiguration'
SUBNET_IDS=subnet-XXXXXXXXXXXXXXXXX,subnet-XXXXXXXXXXXXXXXXX
SECURITY_GROUP_ID=sg-XXXXXXXXXXXXXXXXX
# Only for --create-efs: SG for the new mount targets (must allow
# tcp/2049 from SECURITY_GROUP_ID). Defaults to SECURITY_GROUP_ID.
#EFS_MOUNT_SG_ID=sg-XXXXXXXXXXXXXXXXX

# --- overrides (defaults match current production conventions) -----------
#TASK_ROLE_NAME=benchy-task
#EXEC_ROLE_NAME=benchy-task-exec
#LOG_GROUP=/ecs/benchy-agent
#CPU=1024
#MEMORY=4096
#COPY_IMAGE=public.ecr.aws/amazonlinux/amazonlinux:2023
#PROFILES_ROOT=profiles
#HEALTH_TIMEOUT=300
#ORG_HOSTNAME=agent-<org>.agents.getbenchy.lat          # default derived from ORG
# Secret names the dedicated task definition injects (defaults match the
# current per-service convention; the VALUES are never in this file):
#SECRET_API_KEY=/surus/benchy/agent-<org>/API_SERVER_KEY
#SECRET_BEDROCK=/surus/benchy/agent-<org>/AWS_BEARER_TOKEN_BEDROCK
